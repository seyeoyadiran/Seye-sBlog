<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Create New Post - Admin Dashboard</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  * {margin: 0; padding: 0; box-sizing: border-box;}
  body {background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); color: #fff; font-family: 'Inter', sans-serif; min-height: 100vh;}
  .admin-container {max-width: 900px; margin: 40px auto; background: rgba(23,25,35,0.9); border-radius: 16px; overflow: hidden; backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1);}
  .admin-header {padding: 30px 40px 20px; background: rgba(30,33,48,0.8); border-bottom: 1px solid rgba(255,255,255,0.1);}
  .admin-title {font-size: 2.2rem; font-weight: 700; background: linear-gradient(90deg, #8e44ad, #9b59b6); -webkit-background-clip: text; background-clip: text; color: #FFD700; margin-bottom: 8px;}
  .admin-subtitle {color: rgba(255,255,255,0.7); font-size: 1rem; font-weight: 400;}
  .admin-content {padding: 30px 40px 40px;}
  .status-message {padding: 12px 16px; border-radius: 8px; margin-bottom: 25px; font-weight: 500; display: none;}
  .status-success {background: rgba(46,204,113,0.2); border: 1px solid rgba(46,204,113,0.4); color: #2ecc71;}
  .status-error {background: rgba(231,76,60,0.2); border: 1px solid rgba(231,76,60,0.4); color: #e74c3c;}
  .form-group {margin-bottom: 30px;}
  .form-label {display: flex; align-items: center; margin-bottom: 12px; font-weight: 600; color: #fff; font-size: 1rem;}
  .form-label i {margin-right: 10px; color: #9b59b6; width: 20px; text-align: center;}
  .form-input, .form-textarea, .form-file {width: 100%; padding: 14px 18px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; color: #fff; font-size: 1rem; font-family: 'Inter', sans-serif;}
  .form-input:focus, .form-textarea:focus {border-color: #8e44ad; outline: none; background: rgba(255,255,255,0.08); box-shadow: 0 0 0 3px rgba(142,68,173,0.2);}
  .form-textarea {min-height: 200px; resize: vertical; line-height: 1.6;}
  .form-file {padding: 12px; cursor: pointer;}
  .file-info {display: block; margin-top: 8px; font-size: 0.85rem; color: rgba(255,255,255,0.6);}
  .selected-media {background: rgba(255,255,255,0.03); border-radius: 10px; padding: 20px; margin-bottom: 15px; border: 1px dashed rgba(255,255,255,0.1);}
  .selected-media p {margin-bottom: 15px; font-weight: 500; color: rgba(255,255,255,0.8);}
  #mediaList {display: flex; flex-direction: column; gap: 15px;}
  .media-item {display: flex; flex-direction: column; background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px; position: relative;}
  .media-item img, .media-item video {max-width: 100%; max-height: 250px; border-radius: 6px;}
  .remove-media-btn {position: absolute; top: 8px; right: 8px; background: rgba(231,76,60,0.2); border: 1px solid rgba(231,76,60,0.3); color: #e74c3c; padding: 6px 10px; border-radius: 6px; cursor: pointer;}
  .form-actions {display: flex; justify-content: space-between; align-items: center; margin-top: 35px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.1);}
  .btn {padding: 14px 28px; border-radius: 10px; font-weight: 600; cursor: pointer; border: none; display: flex; align-items: center; gap: 10px; font-size: 1rem;}
  .btn-primary {background: linear-gradient(135deg, #8e44ad, #9b59b6); color: white; box-shadow: 0 4px 15px rgba(142,68,173,0.3);}
  .btn-primary:hover {transform: translateY(-2px); box-shadow: 0 6px 20px rgba(142,68,173,0.4);}
  .btn-secondary {background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.8); border: 1px solid rgba(255,255,255,0.1);}
  .back-link {color: rgba(255,255,255,0.7); text-decoration: none; display: inline-flex; align-items: center; gap: 8px; font-weight: 500;}
  .character-count {text-align: right; margin-top: 5px; font-size: 0.85rem; color: rgba(255,255,255,0.5);}
  @media (max-width: 768px){.form-actions{flex-direction:column;gap:15px;}.btn{width:100%;justify-content:center;}}
</style>
</head>
<body>
<div class="admin-container">
  <div class="admin-header">
    <h1 class="admin-title">Create New Post</h1>
    <p class="admin-subtitle">Craft engaging content for your audience</p>
  </div>
  <div class="admin-content">
    <div class="status-message" id="statusMessage"></div>
    <form method="POST" action="/admin/add-post" enctype="multipart/form-data" id="postForm">
      <input type="hidden" id="mediaRemoved" name="mediaRemoved" value="false">

      <!-- Post Title -->
      <div class="form-group">
        <label for="title" class="form-label"><i class="fas fa-heading"></i> Post Title</label>
        <input type="text" id="title" name="title" class="form-input" placeholder="Enter a compelling title..." required maxlength="120">
        <div class="character-count"><span id="titleCount">0</span>/120 characters</div>
      </div>

      <!-- Featured Media -->
      <div class="form-group">
        <label for="featuredMedia" class="form-label"><i class="fas fa-image"></i> Featured Media</label>
        <div class="selected-media" id="selectedMedia" style="display:none;">
          <p>Selected Media:</p>
          <div id="mediaList"></div>
        </div>
        <input type="file" id="featuredMedia" name="featuredMedia" class="form-file" accept="image/*,video/*" multiple>
        <span class="file-info">Supported: JPEG, PNG, GIF, MP4, MOV, AVI, WebM (Max 50MB each)</span>
      </div>

      <!-- Post Body -->
      <div class="form-group">
        <label for="body" class="form-label"><i class="fas fa-align-left"></i> Content</label>
        <textarea id="body" name="body" class="form-textarea" placeholder="Write your post content here..." required></textarea>
        <div class="character-count"><span id="bodyCount">0</span> characters</div>
      </div>

      <!-- Actions -->
      <div class="form-actions">
        <a href="/admin/dashboard" class="back-link"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
        <div style="display:flex;gap:12px;">
          <a href="/admin/dashboard" class="btn btn-secondary"><i class="fas fa-times"></i> Cancel</a>
          <button type="submit" class="btn btn-primary"><i class="fas fa-plus-circle"></i> Create Post</button>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
const titleInput = document.getElementById('title');
const bodyTextarea = document.getElementById('body');
const titleCount = document.getElementById('titleCount');
const bodyCount = document.getElementById('bodyCount');
const fileInput = document.getElementById('featuredMedia');
const selectedMedia = document.getElementById('selectedMedia');
const mediaList = document.getElementById('mediaList');
const mediaRemovedInput = document.getElementById('mediaRemoved');

// Character counters
titleInput.addEventListener('input', () => titleCount.textContent = titleInput.value.length);
bodyTextarea.addEventListener('input', () => bodyCount.textContent = bodyTextarea.value.length);

// Handle file selection
fileInput.addEventListener('change', (e) => {
  const files = Array.from(e.target.files);
  if (!files.length) { selectedMedia.style.display='none'; mediaList.innerHTML=''; return; }
  selectedMedia.style.display='block';
  mediaList.innerHTML='';
  files.forEach((file,index)=>{
    if(file.size > 50*1024*1024){ alert('Max file size 50MB'); return; }
    const item = document.createElement('div'); item.className='media-item';
    const removeBtn = document.createElement('button'); removeBtn.className='remove-media-btn'; removeBtn.innerHTML='<i class="fas fa-trash"></i>'; 
    removeBtn.onclick = ()=>{ files.splice(index,1); item.remove(); if(!files.length) selectedMedia.style.display='none'; fileInput.value=''; };
    item.appendChild(removeBtn);
    if(file.type.startsWith('image/')) { const img=document.createElement('img'); img.src=URL.createObjectURL(file); item.appendChild(img);}
    else if(file.type.startsWith('video/')) { const vid=document.createElement('video'); vid.src=URL.createObjectURL(file); vid.controls=true; item.appendChild(vid);}
    const name = document.createElement('div'); name.textContent=`${file.name} (${(file.size/1024/1024).toFixed(2)} MB)`; item.appendChild(name);
    mediaList.appendChild(item);
  });
});

// Form submission spinner
document.getElementById('postForm').addEventListener('submit', function(e){
  const btn = this.querySelector('button[type="submit"]');
  btn.innerHTML='<i class="fas fa-spinner"></i> Creating...'; btn.disabled=true;
  setTimeout(()=>{ if(btn.disabled){ btn.innerHTML='<i class="fas fa-plus-circle"></i> Create Post'; btn.disabled=false;} },5000);
});

// Status messages from URL
window.addEventListener('DOMContentLoaded',()=>{
  const params = new URLSearchParams(window.location.search);
  const status = params.get('status'); const message=params.get('message');
  if(status && message){
    const el=document.getElementById('statusMessage');
    el.textContent=message; el.className=`status-message status-${status}`; el.style.display='block';
    if(status==='success') setTimeout(()=>{ el.style.display='none'; },5000);
    history.replaceState({},document.title,window.location.pathname);
  }
  titleCount.textContent = titleInput.value.length;
  bodyCount.textContent = bodyTextarea.value.length;
});
</script>
</body>
</html>
