<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.title %> | Admin</title>
    <meta name="description" content="<%= locals.description %>">
    
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Admin-specific styles -->
    <link rel="stylesheet" href="/css/admin.css">

    <!-- Chart.js for dashboard analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <style>
        body {
            background:#1a1a1a; 
            color:#fff; 
            font-family:'Poppins', sans-serif;
            margin: 0;
            padding: 0;
        }
        
        /* Admin Header Styles */
        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 40px;
            background: rgba(30,30,30,0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        
        .blog-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: #FFD700;
            margin: 0;
            white-space: nowrap;
        }
        
        /* Main Navigation Tabs */
        .main-nav {
            display: flex;
            gap: 30px;
            align-items: center;
            flex-wrap: wrap;
            justify-content: center;
        }
        
        .main-nav a {
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            padding: 8px 0;
            position: relative;
        }
        
        .main-nav a:hover {
            color: #FFD700;
        }
        
        .main-nav a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: #FFD700;
            transition: width 0.3s ease;
        }
        
        .main-nav a:hover::after {
            width: 100%;
        }
        
        /* Admin Actions (Dashboard, Add Post, Logout) */
        .admin-actions {
            display: flex;
            gap: 20px;
            align-items: center;
        }
        
        .admin-actions a {
            color: #fff;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 6px;
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .admin-actions a:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #FFD700;
            border-color: rgba(255, 215, 0, 0.3);
        }
        
        .admin-actions a i {
            font-size: 0.9rem;
        }
        
        /* Main content area */
        .main {
            min-height: 100vh;
            background: #2C2C54;
            font-family: 'Poppins', sans-serif;
            padding: 30px;
        }
        
        /* Footer */
        footer {
            text-align: center;
            padding: 20px;
            font-size: 0.85rem;
            color: #aaa;
            background: rgba(30,30,30,0.9);
        }
        
        /* Responsive adjustments */
        @media (max-width: 1024px) {
            .admin-header {
                padding: 15px 30px;
            }
            
            .main-nav {
                gap: 20px;
            }
            
            .admin-actions {
                gap: 15px;
            }
        }
        
        @media (max-width: 768px) {
            .admin-header {
                flex-direction: column;
                gap: 20px;
                padding: 15px 20px;
            }
            
            .blog-title {
                font-size: 1.6rem;
            }
            
            .main-nav {
                gap: 15px;
                order: 3;
                width: 100%;
                justify-content: center;
                margin-top: 10px;
            }
            
            .admin-actions {
                gap: 10px;
            }
            
            .admin-actions a {
                padding: 6px 12px;
                font-size: 0.9rem;
            }
        }
        
        @media (max-width: 480px) {
            .admin-header {
                padding: 15px;
            }
            
            .main-nav {
                flex-direction: column;
                gap: 10px;
            }
            
            .admin-actions {
                flex-direction: column;
                width: 100%;
                gap: 8px;
            }
            
            .admin-actions a {
                justify-content: center;
                width: 100%;
            }
            
            .blog-title {
                font-size: 1.4rem;
                text-align: center;
            }
        }
    </style>
</head>
<body>

    <!-- 🔹 Admin Header -->
    <header class="admin-header">
        <!-- Blog Title on the left -->
        <h1 class="blog-title">Seye's Blog</h1>
        
        <!-- Navigation Tabs in the center -->
        <nav class="main-nav">
            <a href="/" target="_blank">Home</a>
            <a href="/about" target="_blank">About</a>
            <a href="/contact" target="_blank">Contact</a>
            <a href="/admin/dashboard">Dashboard</a>
        </nav>
        
        <!-- Admin Actions on the right (replacing search) -->
        <div class="admin-actions">
            <a href="/admin/add-post">
                <i class="fas fa-plus"></i> Add Post
            </a>
            <a href="/admin/logout">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </header>

    <main class="main">
        <%- body %>
    </main>
    
    <!-- 🔹 Footer -->
    <footer>
        &copy; <%= new Date().getFullYear() %> Seye's Blog Admin
    </footer>

    <script>
        // Highlight current page in navigation
        document.addEventListener('DOMContentLoaded', function() {
            const currentPage = window.location.pathname;
            const navLinks = document.querySelectorAll('.main-nav a');
            
            navLinks.forEach(link => {
                if (link.getAttribute('href') === currentPage) {
                    link.style.color = '#FFD700';
                    link.style.fontWeight = '600';
                }
            });
        });
    </script>
</body>
</html>